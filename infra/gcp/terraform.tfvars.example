# Copy to terraform.tfvars (git-ignored) and regenerate the bulk of secret_names
# with `node scripts/gcp/migrate-northflank-secrets.mjs --list`. Names only —
# values are seeded with `gcloud secrets versions add`.
#
# The Lili block is REQUIRED when runtime_environment.LILI_CLEARING_LIVE=true
# (cloudrun.tf precondition, secrets.tf lili_secret_names). PAYMENT_HUB_* and
# PAYMENT_SERVER_SERVICE_TOKEN are always declared by secrets.tf and may be
# omitted here.
#
# The Payment Processor OS block (STRIPE_SECRET_KEY, STRIPE_PAYMENTS_SECRET_KEY,
# PAYMENT_DATA_ENCRYPTION_KEY — secrets.tf payment_processor_secret_names) is
# REQUIRED when runtime_environment.PAYMENT_PROCESSOR_LIVE=true; the plan also
# fails if PAYMENT_PROCESSOR_REQUIRE_{APPROVAL,SCREENING}_REF are turned off
# while live. The Lili rail additionally needs the Lili block.
#
# The Payment Gateway OS block (PAYMENT_GATEWAY_WEBHOOK_SECRET plus the two
# shared keys above — secrets.tf payment_gateway_secret_names) is REQUIRED when
# runtime_environment.PAYMENT_GATEWAY_LIVE=true, which also requires
# PAYMENT_PROCESSOR_LIVE=true and the PAYMENT_GATEWAY_REQUIRE_* gates on.
#
# The Enterprise Network OS block (ENTERPRISE_NETWORK_WEBHOOK_SECRET —
# secrets.tf enterprise_network_secret_names) is REQUIRED when
# runtime_environment.ENTERPRISE_NETWORK_LIVE=true, with the
# ENTERPRISE_NETWORK_REQUIRE_* gates on.
#
# The Private Payment Network block (PRIVATE_PAYMENT_NETWORK_WEBHOOK_SECRET plus
# PAYMENT_DATA_ENCRYPTION_KEY and STRIPE_PAYMENTS_SECRET_KEY — secrets.tf
# private_payment_network_secret_names) is REQUIRED when
# runtime_environment.PRIVATE_PAYMENT_NETWORK_LIVE=true, which also requires
# PAYMENT_PROCESSOR_LIVE=true, ENTERPRISE_NETWORK_LIVE=true and the
# PRIVATE_PAYMENT_NETWORK_REQUIRE_* gates on. Its mft_as2 file drop
# (runtime_environment.PRIVATE_PAYMENT_NETWORK_MFT_LIVE=true) also requires
# MFTGATEWAY_API_TOKEN_ID and MFTGATEWAY_API_TOKEN_SECRET. Its Fineract
# core-banking funding source (runtime_environment.CANONICAL_FUNDING_LIVE=true,
# CANONICAL_FUNDING_SAVINGS_ACCOUNT_ID = trust savings account of record) also
# requires FINERACT_URL, FINERACT_USERNAME and FINERACT_PASSWORD.
#
# The Banking Aggregator block is REQUIRED when
# runtime_environment.AGGREGATOR_DEFAULT_MODE=live (the production default):
# ADMIN_SECRET_TOKEN plus at least one per-connection credential named
# AGGREGATOR_<CONNECTION>_API_KEY / AGGREGATOR_<CONNECTION>_WEBHOOK_SECRET
# (also *_API_SECRET, *_BEARER_TOKEN, *_CLIENT_SECRET), where <CONNECTION> is
# the connection name upper-cased with non-alphanumerics as '_' (or
# config.credentialsEnvPrefix). bankingAggregator.js projects them onto the
# connection's apiKey / webhookSecret / apiSecret / bearerToken / clientSecret
# at load time (secrets.tf missing_aggregator_secrets, cloudrun.tf precondition).

project_id = "dlb-treasury-management"

secret_names = [
  # … everything printed by migrate-northflank-secrets.mjs --list …

  # Lili MCP OAuth (S2S reconciliation feed) — captured once by
  # server/scripts/liliMcpOAuthSetup.js, then seeded here.
  "LILI_OAUTH_CLIENT_ID",
  "LILI_OAUTH_CLIENT_SECRET",
  "LILI_OAUTH_REFRESH_TOKEN",
  "LILI_BUSINESS_USER_ID",
  # Full Lili (RDFI) account number; routing/name are plain runtime_environment.
  "LILI_DD_ACCOUNT_NUMBER",
  # Treasury (ODFI) operating account debited by the Lili credit.
  "CLEARING_FUNDING_OPERATING_ACCOUNT",
  # Bearer token for /api/payment-server/v1/* (server/routes/bankSettlement.js).
  "PAYMENT_SERVER_SERVICE_TOKEN",
  # Payment Processor OS live plan (PAYMENT_PROCESSOR_LIVE=true). Already in
  # the migrate-northflank-secrets.mjs --list output; listed for clarity.
  "STRIPE_SECRET_KEY",
  "STRIPE_PAYMENTS_SECRET_KEY",
  "PAYMENT_DATA_ENCRYPTION_KEY",
  # Payment Gateway OS live plan (PAYMENT_GATEWAY_LIVE=true): HMAC-SHA256 key
  # for processor callbacks to /api/os/payment-gateway/webhook.
  "PAYMENT_GATEWAY_WEBHOOK_SECRET",
  # Enterprise Network OS live plan (ENTERPRISE_NETWORK_LIVE=true): HMAC-SHA256
  # key for screening / partner callbacks to /api/os/enterprise-network/webhook.
  "ENTERPRISE_NETWORK_WEBHOOK_SECRET",
  # Fineract core banking (dlbtrust-fineract Cloud Run): PPN funding source of
  # record when CANONICAL_FUNDING_LIVE=true. Already in the migrate list.
  "FINERACT_URL",
  "FINERACT_USERNAME",
  "FINERACT_PASSWORD",
  # Private Payment Network live plan (PRIVATE_PAYMENT_NETWORK_LIVE=true): HMAC-
  # SHA256 key for processor callbacks to /api/os/private-payment-network/webhook.
  "PRIVATE_PAYMENT_NETWORK_WEBHOOK_SECRET",
  # Banking Aggregator live plan (AGGREGATOR_DEFAULT_MODE=live): admin token for
  # /api/aggregator/* and one credential set per provider connection. Rename
  # <CONNECTION> to the connection name (e.g. a connection "Lili Ops" reads
  # AGGREGATOR_LILI_OPS_API_KEY / AGGREGATOR_LILI_OPS_WEBHOOK_SECRET).
  "ADMIN_SECRET_TOKEN",
  # "AGGREGATOR_<CONNECTION>_API_KEY",
  # "AGGREGATOR_<CONNECTION>_WEBHOOK_SECRET",
  # Betterment Trust Checking (read-only; Betterment has no API of its own).
  # BankSync connection CONN-BETTERMENT-TRUST-CHECKING (banksync connector):
  # the workspace key, or a connection-scoped copy of it. Requires a BankSync
  # plan with API access (Standard or above).
  "BANKSYNC_API_KEY",
  # "AGGREGATOR_BETTERMENT_TRUST_CHECKING_API_KEY",
  # Orange Rails connection CONN-BETTERMENT-TRUST-CHECKING-ORANGERAILS
  # (orangerails connector, Apache-2.0 github.com/Orange-The-World/orangerails):
  # the platform key issued by Orange Rails plus two base64 32-byte keys the
  # trust generates itself (`openssl rand -base64 32`) — the vault key Orange
  # Rails requires on every sync and the AES-256-GCM key every transaction is
  # stored under upstream and decrypted only inside Cloud Run. Bank login
  # happens in the Quiltt widget (POST /api/aggregator/connections/:id/link-token).
  "ORANGERAILS_PLATFORM_API_KEY",
  "ORANGERAILS_CREDENTIALS_KEY",
  "ORANGERAILS_TRANSACTIONS_KEY",
  # (or connection-scoped: AGGREGATOR_BETTERMENT_TRUST_CHECKING_ORANGERAILS_API_KEY /
  #  _CREDENTIALS_KEY / _TRANSACTIONS_KEY)
  # SimpleFIN connection CONN-BETTERMENT-TRUST-CHECKING-SIMPLEFIN (simplefin
  # connector — the bank-data path of the Apache-2.0 Alderfi platform,
  # github.com/Earleybeast/mcp): the SimpleFIN Bridge Access URL
  # (https://user:pass@beta-bridge.simplefin.org/simplefin) claimed once from a
  # Setup Token via aggregateBettermentTrustChecking.js --claim-setup-token.
  # Betterment is connected in the Bridge ("Login with App Password").
  "SIMPLEFIN_ACCESS_URL",
  # (or connection-scoped: AGGREGATOR_BETTERMENT_TRUST_CHECKING_SIMPLEFIN_ACCESS_URL)
  # ODFI channel credentials when ACH_SFTP_URL is the chosen channel.
  # "ACH_SFTP_KEY",
  # "ACH_SFTP_PASSWORD",
]

# Declared above but not yet seeded (`gcloud secrets versions add`): Cloud Run
# rejects a revision referencing a version-less secret, so keep such names here
# until seeded, then remove them and re-apply.
unseeded_secret_names = [
  "LILI_OAUTH_CLIENT_SECRET",
  "LILI_OAUTH_REFRESH_TOKEN",
  "LILI_BUSINESS_USER_ID",
]
