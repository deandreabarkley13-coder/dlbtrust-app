# ─── OpenACH API Credentials ─────────────────────────────────────────────────
# OpenACH runs as the `openach` service in the Northflank project (built from
# openach/Dockerfile); its api lives at <service-url>/api.

OPENACH_BASE_URL=https://p01--openach--<project-hash>.code.run/api
OPENACH_API_TOKEN=REPLACE_WITH_TOKEN_FROM_SETUP_SCRIPT
OPENACH_API_KEY=REPLACE_WITH_KEY_FROM_SETUP_SCRIPT

# Token, key and payment type ids are all printed by:
#   OPENACH_DATABASE_URL=... OPENACH_BASE_URL=... \
#     node server/integrations/openach/server-side-setup.js
# (see docs/OPENACH_NORTHFLANK.md)
OPENACH_PAYMENT_TYPE_ID=REPLACE_AFTER_RUNNING_SETUP
