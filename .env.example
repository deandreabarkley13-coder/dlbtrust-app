TRUST_CHECKER_LEGAL_NAME=DeAndrea Lavar Barkley
TRUST_SIGNATURE_DOCUMENT_PATH=data/governance/Trustees_Signature_Page.pdf

# ─── Lili Bank / MCP Payments OS Engine ─────────────────────────────────────────
# Direct payment endpoint (rare; Lili does not publish a public outbound payments API).
# Most deployments should use MCP OAuth + Bill Pay tools below.
LILI_PAYMENT_ENDPOINT=
LILI_BASE_URL=https://prod.lili.co
LILI_ACCESS_KEY=__SET_VIA_SECRET__
LILI_SECRET_KEY=__SET_VIA_SECRET__
# MCP OAuth + resource server
LILI_MCP_ENABLED=true
LILI_MCP_URL=https://mcp.lili.co/mcp
LILI_OAUTH_BASE_URL=https://mcp.lili.co
LILI_OAUTH_CLIENT_ID=
LILI_OAUTH_CLIENT_SECRET=__SET_VIA_SECRET__
LILI_OAUTH_ACCESS_TOKEN=__SET_VIA_SECRET__
LILI_OAUTH_REFRESH_TOKEN=__SET_VIA_SECRET__
LILI_OAUTH_REDIRECT_URI=http://127.0.0.1:3000/oauth/callback
LILI_OAUTH_RESOURCE=https://mcp.lili.co/
LILI_BUSINESS_USER_ID=

# ─── Account Abstraction / Gas Abstraction (EIP-4337 v0.6) ─────────────────────
AA_ENABLED=true
# true = shadow/demo, false = live on-chain via Alchemy + Particle free bundler
AA_SHADOW=true
AA_BUNDLER_URL=https://bundler.particle.network
# EntryPoint v0.6 and canonical SimpleAccountFactory on Sepolia
AA_ENTRY_POINT=0x5FF137D4b0FDCD49DcA30c7CF57E578a026d2789
AA_FACTORY=0x9406Cc6185a346906296840746125a0E44976454
# Optional: reuse already-deployed SovereignTrustPaymaster
AA_PAYMASTER_ADDRESS=
AA_VALIDITY_WINDOW_SEC=300

# ─── Two-Trustee Configuration (Administration + Distribution) ───────────────────
TRUST_ADMIN_NAME=DeAndrea Lavar Barkley
TRUST_ADMIN_EMAIL=deandreabarkley13@gmail.com
TRUST_ADMIN_PHONE=(216)632-2353
# Optional: EVM address for on-chain signature verification
TRUST_ADMIN_ADDRESS=
TRUST_DIST_NAME=Malissa Ann Robinson
TRUST_DIST_EMAIL=malissa1130@gmail.com
TRUST_DIST_PHONE=(216)484-4804
# Optional: EVM address for on-chain signature verification
TRUST_DIST_ADDRESS=
TRUST_MAKER_NAME=Malissa Robinson
TRUST_MAKER_EMAIL=malissa1130@gmail.com
TRUST_MAKER_PHONE=
TRUST_MAKER_ADDRESS=
TRUST_MAKER_LEGAL_NAME=Malissa Ann Robinson
# Optional extra addresses a trustee may sign in from (comma separated). The
# primary email above stays the address of record for notices and signatures.
TRUST_MAKER_ALT_EMAILS=
TRUST_CHECKER_ALT_EMAILS=
TRUST_LIQUID_ASSET_SUBTYPES=cash,checking,operating,settlement
TRUST_SEGREGATED_ACCOUNT_CODES=1210
TRUST_ADMIN_ALT_EMAILS=
TRUST_DIST_ALT_EMAILS=

# ─── Push-to-Card Providers ─────────────────────────────────────────────────────
VISA_DIRECT_API_KEY=
VISA_DIRECT_SHARED_SECRET=
VISA_DIRECT_URL=
VISA_DIRECT_LIVE=false
FORMANCE_API_URL=
FORMANCE_API_TOKEN=
FORMANCE_CONNECTOR_ID=
FORMANCE_SOURCE_ACCOUNT_ID=
FORMANCE_DESTINATION_ACCOUNT_ID=
APACHE_HTTP_PUSH_URL=
# Legacy fallback keys for the direct Apache HTTP wire/push endpoints.
# Leave blank unless you are intentionally using wireOriginationEngine or pushToCardEngine.
APACHE_HTTP_API_KEY=
APACHE_WIRE_API_KEY=

# ─── Apache APISIX (self-hosted API gateway for PTC wire / push rails) ──────────
# APISIX proxies /ptc/wire and /ptc/push to the self-hosted apache-ptc API.
# Set APISIX_LIVE=true once the gateway and apache-ptc containers are running.
APISIX_LIVE=false
APISIX_API_URL=http://localhost:9080
APISIX_ADMIN_URL=http://localhost:9180
# Gateway API key sent to apache-ptc as X-API-Key. Generate a strong secret for
# local testing (e.g. `openssl rand -hex 32`) and never commit it.
APISIX_API_KEY=
# Path on the gateway for wire/push endpoints.
APISIX_WIRE_PATH=/ptc/wire
APISIX_PUSH_PATH=/ptc/push
# Security: in live mode only HTTPS URLs are allowed unless APISIX_ALLOW_HTTP=true.
# Set to true ONLY for local self-hosted APISIX testing (required when APISIX_API_URL
# is an http:// address); leave false in production.
APISIX_ALLOW_HTTP=false
# Comma-separated list of allowed gateway hosts (e.g. apisix.example.com,*.example.com).
APISIX_ALLOWED_HOSTS=
# ODFI = originator bank details. Defaults to DB NET MGMT at Lili Bank for local testing.
APISIX_ODFI_ROUTING=121145307
APISIX_ODFI_ACCOUNT=692101092959
APISIX_ODFI_NAME=DB NET MGMT
APISIX_ODFI_BANK_NAME=Lili Bank
# RDFI = receiver bank details. Defaults to DB NET MGMT at Lili Bank.
APISIX_RDFI_ROUTING=121145307
APISIX_RDFI_ACCOUNT=692101092959
APISIX_RDFI_NAME=DB NET MGMT
APISIX_RDFI_BANK_NAME=Lili Bank
# Source-of-funds GL account for interest distributions.
APISIX_SOURCE_GL=4000

# ─── BankSync Open Banking ──────────────────────────────────────────────────────
BANKSYNC_API_KEY=
BANKSYNC_BASE_URL=https://api.banksync.io/v1

# ─── OS Engines: bank aggregator and funding ────────────────────────────────────
# Set to true only when the underlying provider credentials are configured and you
# are ready for real data exchange or value movement.
BANK_AGGREGATOR_LIVE=false
FUNDING_LIVE=false

# Optional external addresses the Funding engine can use to plan value movement.
FUNDING_EXTERNAL_EVM_ADDRESS=
FUNDING_HEDERA_ACCOUNT_ID=

# ─── Treasury Prime (BaaS: accounts, book transfers, ACH, wires) ────────────────
# Basic auth: key ID is the username, secret is the password. Amounts on this
# rail are decimal strings ("250.00"), not integer cents.
TREASURY_PRIME_API_KEY_ID=
TREASURY_PRIME_API_SECRET=
# Sandbox by default; set to https://api.treasuryprime.com to move real money.
TREASURY_PRIME_BASE_URL=https://api.sandbox.treasuryprime.com
TREASURY_PRIME_TIMEOUT_MS=30000
# Shared secret required on POST /api/treasury-prime/webhooks/receive (x-treasury-prime-secret).
TREASURY_PRIME_WEBHOOK_SECRET=

# ─── OS Engines (bookkeeping, cash, asset acquisition) ────────────────────────────
# Set to true only when the underlying provider credentials are configured and you
# are ready for real side effects (vendor payments, Fineract GL posts, asset JE posts).
BOOKKEEPING_LIVE=false
CASH_LIVE=false
ASSET_ACQUISITION_LIVE=false

# ─── OS Engine: Smart Router ──────────────────────────────────────────────────────
# Orchestrates payment delivery, confirmation, and receipt across fiat, stablecoin,
# and canonical money rails. Only set LIVE=true when you are ready to move real value.
SMART_ROUTER_LIVE=false
# Set AUTO_APPROVE only if the smart-router may auto-approve canonical money proposals.
SMART_ROUTER_AUTO_APPROVE=false

# ─── OS Engine: Back Office ───────────────────────────────────────────────────────
# Heavy treasury, banking, and distributions processing for the PTC. Set LIVE=true
# only when the underlying ledger/bank/distribution providers are configured.
BACK_OFFICE_LIVE=false

# ─── OS Engine: Settlement Endpoint (agent-to-agent M2M fiat handshake) ───────────
# This node publishes /.well-known/dlb-trust-settlement.json and discovers remote
# settlement endpoints. SETTLEMENT_API_KEY is the local node's bearer token.
# APP_URL or DEPLOY_URL must be set to your public HTTPS URL for remote agents.
SETTLEMENT_AGENT_ID=DLB Trust PTC
# Shared secret used to sign/verify agent-to-agent handshake challenges.
# Falls back to JWT_SECRET then SETTLEMENT_API_KEY. Must be identical on both peers.
SETTLEMENT_NETWORK_KEY=
SETTLEMENT_API_KEY=
SETTLEMENT_DISCOVERY_URLS=
SETTLEMENT_AUTO_HANDSHAKE=false
SETTLEMENT_AUTO_DISCOVER=true
SETTLEMENT_VERIFY_SIGNATURES=true
# Allow discovery/handshake to internal/private addresses (localhost, RFC1918, etc).
# Defaults to true in development, false in production.
SETTLEMENT_ALLOW_PRIVATE=false

# ─── Nickel MCP/REST accounts-payable rail ───────────────────────────────────────
# Shadow mode is enabled by default so the engine simulates vendor/bill/payment
# flows until NICKEL_API_KEY or OAuth tokens are configured. Set NICKEL_LIVE=true
# and NICKEL_SHADOW=false only when ready to originate real payments.
NICKEL_MCP_URL=https://mcp.nickel.com/mcp
NICKEL_REST_URL=https://rest.nickel.com
NICKEL_LIVE=false
NICKEL_SHADOW=true
NICKEL_API_KEY=
NICKEL_CLIENT_ID=
NICKEL_CLIENT_SECRET=
NICKEL_OAUTH_REDIRECT_URI=http://localhost:3000/oauth/callback
NICKEL_PAYABLES_GL_ACCOUNT=2100
NICKEL_SETTLEMENT_GL_ACCOUNT=1000
NICKEL_SOURCE_ACCOUNT_ID=4000
NICKEL_PAY_BILLS_EMAIL=
NICKEL_WEBHOOK_SECRET=
NICKEL_AUTO_SETTLE=false
NICKEL_POST_PAYABLE_GL=true
