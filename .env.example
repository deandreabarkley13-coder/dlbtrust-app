# Trustee Checker Admin Credentials
# The trustee checker is seeded as an admin user on startup.
# Email/name default to the checker trustee in server/integrations/dapp/trustees.js
# and can be overridden with TRUST_CHECKER_EMAIL / TRUST_CHECKER_NAME.
# TRUST_CHECKER_ADMIN_PASSWORD is REQUIRED and must be at least 8 characters.
# It is intentionally NOT derived from ADMIN_SECRET_TOKEN.
TRUST_CHECKER_EMAIL=deandreabarkley13@gmail.com
TRUST_CHECKER_NAME=DeAndrea Barkley
TRUST_CHECKER_ADMIN_PASSWORD=__SET_VIA_SECRET__

# Stripe Treasury payouts (set as secrets, never commit real keys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_TREASURY_FINANCIAL_ACCOUNT_ID=fa_...

# Payment system mode: 'sandbox' (default) or 'production'
# Set to 'production' when ready for real money movement
PAYMENT_MODE=sandbox

# PostgreSQL bond database name
BOND_DB_NAME=fineract_tenants

# OpenACH Configuration
# ODFI: Eaton Family Credit Union (routing: 241075470)
# NOTE: never commit real tokens/keys here — set these as secrets, not in git.
# Any values previously committed here are exposed and MUST be rotated
# (see SECURITY_REMEDIATION.md).
OPENACH_BASE_URL=https://your-openach-host/openach/api
OPENACH_API_TOKEN=__SET_VIA_SECRET__
OPENACH_API_KEY=__SET_VIA_SECRET__
# Get this by running: node server/integrations/openach/test-api.js
OPENACH_PAYMENT_TYPE_ID=

# ─── Trust identity (protected identifiers — set via secrets, never commit) ────
# Redacted in logs/responses; used to attribute payment files to the trust entity.
TRUST_ID=__SET_VIA_SECRET__
TRUST_MASTER_ACCOUNT=__SET_VIA_SECRET__
TRUST_NAME=DLB Trust

# ─── Eaton Family CU trust deposit + SFTP file drop ───────────────────────────
TRUST_BANK_ROUTING=241075470
TRUST_BANK_ACCOUNT=__SET_VIA_SECRET__
TRUST_BANK_NAME=Eaton Family CU Trust Checking
TRUST_BANK_AUTO_TRANSMIT=false

# ─── PTC Bank (Family Trust Company internal bank) ─────────────────────────────
# Set PTC_BANK_LIVE=true to enable real external ACH/wire/open-banking rails.
# Use PTC_BANK_ROUTING/NAME to override the trust bank settlement account.
PTC_BANK_LIVE=false
PTC_BANK_SETTLEMENT_ACCOUNT=
PTC_BANK_ROUTING=111000025
PTC_BANK_NAME=DLB Trust PTC Bank
PTC_BANK_GL_ACCOUNT=1010

# ─── PTC Treasury (canonical PTC day-to-day workflow engine) ───────────────────
# Set PTC_TREASURY_LIVE=true once connected to live payment rails.
PTC_TREASURY_LIVE=false

# ─── Moov Paygate (self-hosted Apache 2.0 ACH/wire/RTP gateway) ─────────────────
# Set MOOV_PAYGATE_LIVE=true to call a real Paygate instance.
MOOV_PAYGATE_LIVE=false
MOOV_PAYGATE_URL=http://localhost:8082
MOOV_PAYGATE_ADMIN_URL=http://localhost:9092
MOOV_CUSTOMERS_URL=http://localhost:8087
MOOV_PAYGATE_ORG=dlbtrust
MOOV_PAYGATE_API_KEY=
# In live mode only HTTPS endpoints are allowed unless this is true.
MOOV_PAYGATE_ALLOW_HTTP=false
# Optional comma-separated allowlist of hosts/wildcards, e.g.: paygate.lan,*.example.com
MOOV_PAYGATE_ALLOWED_HOSTS=
MOOV_PAYGATE_ODFI_ROUTING=
MOOV_PAYGATE_ORIGINATOR_NAME=DLB Trust PTC Bank
# Generate with: bash scripts/generate-moov-symmetric-key.sh
MOOV_PAYGATE_SYMMETRIC_KEY=
# Optional secret used to verify incoming Moov Paygate webhooks.
MOOV_PAYGATE_WEBHOOK_SECRET=

# sftp://user@host:port/incoming — presence enables SFTP delivery
ACH_SFTP_URL=
ACH_SFTP_KEY=/path/to/ssh-private-key
ACH_SFTP_PASSWORD=__SET_VIA_SECRET__
ACH_SFTP_KNOWN_HOSTS=/path/to/known_hosts
ACH_SFTP_RETURN_PATH=/outbound
ACH_RETURNS_DIR=data/ach-returns

# AS2 Pipeline Configuration (ACH file delivery to bank)
AS2_PARTNER_URL=https://your-bank-as2-endpoint.com/as2
AS2_PARTNER_AS2_ID=BANK-AS2-ID
AS2_LOCAL_AS2_ID=DLBTRUST-AS2
AS2_SIGNING_CERT=/path/to/signing-cert.pem
AS2_SIGNING_KEY=/path/to/signing-key.pem
AS2_PARTNER_CERT=/path/to/partner-cert.pem
AS2_ENCRYPTION_ALG=aes256-cbc
AS2_SIGNING_ALG=sha256
AS2_REQUEST_MDN=true
AS2_MESSAGE_ID_DOMAIN=dlbtrust-app.fly.dev
AS2_PRODUCTION_APPROVED=false

# ─── Mutual TLS (client certificate) ──────────────────────────────────────────
# These are ONLY needed when the receiving bank/ISO 20022 endpoint requires a
# client-certificate (mutual TLS) handshake. They are additive to header auth —
# a bank channel may require BOTH a client cert AND a bearer token. Leave unset
# for standard bearer/basic/api_key/hmac partners.
#
# Per-partner mTLS is configured in the dashboard (Partners form) or the
# System Settings "External Bank Endpoint" card (persisted as
# bank_use_mtls / bank_client_cert_path / bank_client_key_path /
# bank_client_ca_path / bank_client_key_passphrase). The env vars below apply
# to the legacy single-partner AS2 client and the NiFi push engine.

# Legacy single-partner AS2 client mTLS
AS2_USE_MTLS=false
AS2_CLIENT_CERT=/path/to/client-cert.pem
AS2_CLIENT_KEY=/path/to/client-key.pem
AS2_CLIENT_CA=/path/to/ca.pem
AS2_CLIENT_KEY_PASSPHRASE=

# NiFi ListenHTTP push mTLS (used by nifiPaymentEngine.pushToNiFi)
NIFI_USE_MTLS=false
NIFI_CLIENT_CERT_PATH=/path/to/nifi-client-cert.pem
NIFI_CLIENT_KEY_PATH=/path/to/nifi-client-key.pem
NIFI_CLIENT_CA_PATH=/path/to/nifi-ca.pem
NIFI_CLIENT_KEY_PASSPHRASE=

# Banking Aggregator (bi-directional financial data hub)
# Provider connections are configured at runtime via the dashboard
# ("Banking Aggregator" page) or the /api/aggregator API and persisted in
# PostgreSQL (aggregator_* tables) — there are NO required env vars.
# Each connection stores its own baseUrl, auth (bearer/api_key/basic/hmac),
# optional mutual-TLS cert paths, and an optional webhook secret.
# Inbound provider webhooks are received (and HMAC-verified) at:
#   POST /api/aggregator/webhooks/<connectionId>

# ACH files storage directory (default: data/ach-files)
# ACH_FILES_DIR=/var/data/ach-files

# Payment Hub orchestration: disabled, shadow, local_ach, or phee
# Default: disabled (requires configuration before enabling)
PAYMENT_HUB_MODE=disabled
PAYMENT_HUB_LIVE=false
PAYMENT_APPROVAL_THRESHOLD=2
PAYMENT_ALLOW_SELF_APPROVAL=false
PAYMENT_HOLD_HOURS=72

# Generate with: openssl rand -hex 32
PAYMENT_DATA_ENCRYPTION_KEY=replace-with-64-hex-characters
PAYMENT_HUB_SERVICE_TOKEN=replace-with-a-random-service-token
PAYMENT_HUB_WEBHOOK_SECRET=replace-with-a-random-webhook-secret
PAYMENT_HUB_WEBHOOK_MAX_AGE_SECONDS=300

# Required only when PAYMENT_HUB_MODE=phee
PAYMENT_HUB_BASE_URL=https://payment-hub.example.com
PAYMENT_HUB_AUTH_TOKEN=replace-with-payment-hub-api-token
PAYMENT_HUB_CALLBACK_URL=https://dlbtrust-app.fly.dev/api/payment-hub/webhooks/status
PAYMENT_HUB_ACH_CONNECTOR_URL=https://dlbtrust-app.fly.dev/api/payment-hub/connectors/us-ach/execute
PAYMENT_HUB_TIMEOUT_MS=15000
PAYMENT_HUB_MAX_RETRIES=3

# ─── Open Agent ID — DID-backed agent identity and credit API ────────────────
# Base URL should NOT end in /v1 (the SDK adds /v1 internally)
OPEN_AGENT_ID_BASE_URL=https://api.openagentid.org
OPEN_AGENT_ID_AUTO_REGISTER=true
OPEN_AGENT_ID_AGENT_NAME=dlbtrust
# Comma-separated list, e.g.: payments, credit, treasury
OPEN_AGENT_ID_CAPABILITIES=
# Encryption key for the wallet and Ed25519 private keys stored in Postgres.
# Must be 64 hex chars or 43-char base64url. Falls back to PAYMENT_DATA_ENCRYPTION_KEY.
# Generate with: openssl rand -hex 32
OPEN_AGENT_ID_ENCRYPTION_KEY=replace-with-64-hex-characters

