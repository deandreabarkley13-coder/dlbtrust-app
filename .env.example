# ─── DeFi dApp: SAFE multisig, bond tokenization, and DEX swap ───────────────
DAPP_ENABLED=true
# false = live on-chain, true = shadow/demo
DAPP_SHADOW=false
# DEV ONLY: when true, and NODE_ENV is not production, send-code exposes the OTP for local testing.
# Never enable this in a deployed environment; the PIN is never prefilled by the UI.
DAPP_OTP_ALWAYS_SHOW_CODE=false
# 1 = Ethereum mainnet, 11155111 = Sepolia testnet, 8453 = Base mainnet
DAPP_CHAIN_ID=8453
DAPP_RPC_URL=https://mainnet.base.org
# Base USDC: 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# Ethereum mainnet USDC: 0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48
DAPP_USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# Private key for the operator hot wallet (set via secret — never commit)
DAPP_PRIVATE_KEY=
# Agent Wallet that should receive real on-chain value from OS engines
AGENT_WALLET_ADDRESS=0x69a32f285ced1dbf102c7baedf0266f1d39580a1
# true = simulate tokenization flows without submitting on-chain
TOKENIZATION_SHADOW=true
# Alchemy API key. If set, the app will prefer Alchemy RPC endpoints for the
# configured DAPP_CHAIN_ID (Base, Ethereum, Polygon, Arbitrum). DAPP_RPC_URL
# still takes precedence when set explicitly.
ALCHEMY_API_KEY=
# Set to true to allow the Alchemy Wallet OS Engine to submit real on-chain sends.
# Defaults to dry-run/shadow mode; requires a funded Alchemy local or session signer.
ALCHEMY_WALLET_SEND_LIVE=false
# Optional: derive the operator address from the private key; set explicitly if needed
DAPP_OPERATOR_ADDRESS=
# Source method used when funding the Agent Wallet from the operating account:
# manual, moonpay, circle_mint, coinbase_treasury, core_banking_wire
AGENT_WALLET_SOURCE_METHOD=manual
# MoonPay CLI on-ramp integration (uses the locally authenticated `mp` executable)
MOONPAY_CLI_ENABLED=true
# Optional absolute path to the `mp` binary if it is not on the server PATH
MOONPAY_CLI_PATH=
# Operator Gas Tank: auto-replenish operator ETH from a source-of-funds ledger
OPERATOR_GAS_TANK_MODE=dex
OPERATOR_GAS_TANK_THRESHOLD_ETH=0.005
OPERATOR_GAS_TANK_TOPUP_USD=100
OPERATOR_GAS_TANK_SOURCE_TYPE=treasury
OPERATOR_GAS_TANK_SOURCE_ACCOUNT_ID=TREASURY_HOT
OPERATOR_GAS_TANK_TARGET_ASSET=ETH
OPERATOR_GAS_TANK_TARGET_NETWORK=ethereum
# If DEX mode and no DLBUSD/WETH pool exists, set to true to create one. It requires operator WETH to seed.
OPERATOR_GAS_TANK_CREATE_POOL=false
OPERATOR_GAS_TANK_POOL_SEED_WETH=0
OPERATOR_GAS_TANK_POOL_SEED_DLBUSD=0.2
# Optional: auto-seed the EIP-4337 paymaster with this ETH amount after each top-up (0 to disable)
OPERATOR_GAS_TANK_SEED_PAYMASTER_ETH=0
# Set to true to auto-run the gas-tank check on a timer (default every 5 minutes)
OPERATOR_GAS_TANK_AUTO_CHECK=false
OPERATOR_GAS_TANK_CHECK_INTERVAL_MS=300000
# Trust $Cashtag for Cash App QR funding (no $ prefix)
CASHAPP_CASHTAG=
