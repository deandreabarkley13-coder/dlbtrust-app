BOND_TOKEN_BYTECODE_PATH=./artifacts/contracts_BondToken_sol_BondToken.bin
BOND_TOKEN_ABI_PATH=./artifacts/contracts_BondToken_sol_BondToken.abi
BOND_TOKEN_ADDRESS=0xfd185df6ea640f44dd8b57a440baa90b9c545726
